{
  "name": "atidi-payload",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "tsx src/lib/bootstrap-storage.ts",
    "prebuild": "tsx src/lib/bootstrap-storage.ts",
    "prestart": "tsx src/lib/bootstrap-storage.ts",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "generate:types": "payload generate:types",
    "generate:graphQLSchema": "payload generate:graphQLSchema",
    "seed": "tsx src/seed/index.ts",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@ai-stack/payloadcms": "^3.2.26",
    "@aws-sdk/client-cloudfront": "^3.987.0",
    "@payloadcms/db-postgres": "^3.0.0",
    "@payloadcms/next": "^3.0.0",
    "@payloadcms/plugin-seo": "^3.0.0",
    "@payloadcms/richtext-lexical": "^3.0.0",
    "@payloadcms/storage-s3": "^3.0.0",
    "@types/qrcode": "^1.5.6",
    "cross-env": "^7.0.3",
    "framer-motion": "^12.31.2",
    "graphql": "^16.9.0",
    "lucide-react": "^0.563.0",
    "next": "^15.0.0",
    "otplib": "^13.2.1",
    "payload": "^3.0.0",
    "payload-plugin-cloudflare-purge": "^2.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "docxtemplater": "^3.68.3",
    "docxtemplater-image-module-free": "^1.1.1",
    "dotenv": "^16.4.0",
    "file-saver": "^2.0.5",
    "pizzip": "^3.2.0",
    "playwright": "^1.58.2",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
